{
  // Cloudflare Workers 정적 자산(Static Assets) 배포 설정.
  // 배포되는 건 ./public 폴더뿐이다. 원본 기록(Diet/, recording_weight/)은 절대 업로드되지 않는다.
  //
  // ./public 은 아래 build.command 가 index.html 하나만 복사해서 만든다. 직접 수정하지 말 것.
  // public/ 은 git 에 올라가지 않으므로(빌드 결과물), Cloudflare 의 git 연동 빌드처럼
  // 레포를 새로 클론해서 배포하는 환경에서는 이 build 단계가 없으면
  // "assets.directory ... does not exist" 로 실패한다. 그래서 wrangler 설정에 넣어 둔다.
  // (wrangler 는 deploy / dev 전에 build.command 를 실행한다 — 로컬·CI 양쪽에서 동일하게 동작)
  "name": "jinwoong-diet",
  "compatibility_date": "2026-09-22",
  "build": {
    "command": "rm -rf public && mkdir -p public && cp index.html public/index.html"
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
